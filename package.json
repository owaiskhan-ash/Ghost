{
  "name": "ghost-whatsapp-scheduler",
  "private": true,
  "version": "1.9.0",
  "description": "Ghost — responsive Windows and Android WhatsApp scheduler",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "build:apk": "bash scripts/build-apk.sh",
    "desktop": "npm run build && electron .",
    "desktop:dev": "npm run build && electron .",
    "test:desktop": "node --test desktop/automation.test.cjs",
    "build:windows": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "ai.ghost.desktop",
    "productName": "Ghost",
    "asar": true,
    "directories": {
      "output": "releases/desktop",
      "buildResources": "desktop/assets"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*.cjs",
      "desktop/assets/desktop-icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "desktop/assets/desktop-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Ghost-Desktop-v${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ghost"
    }
  },
  "author": "Ghost"
}
