{
  "name": "ghost-whatsapp-scheduler",
  "private": true,
  "version": "1.2.0",
  "description": "Ghost — Select a contact and schedule WhatsApp messages at any exact time",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
